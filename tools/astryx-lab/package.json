{
  "name": "todaystrack-astryx-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Astryx tooling and component sandbox; separate from the Android app and current UI review.",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "astryx": "node --import ./cli-env.mjs node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "build": "node build.mjs",
    "build:home": "node build-home.mjs",
    "check:home": "npm run astryx -- doctor --built .local/home-review",
    "preview": "node server.mjs",
    "check": "npm run astryx -- doctor --built .local/dist"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.15",
    "@astryxdesign/theme-neutral": "0.7.15",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.15",
    "esbuild": "0.28.2"
  }
}
