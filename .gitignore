# Keep raw device records, captures and generated media outside Git.
validation/evidence/
validation/**/runs/
validation/**/results/
validation/**/*-latest.json
validation/*-probe/latest-*.json
validation/*-probe/release-setup.json
# Separate upstream SDK sample checkouts are kept in the local workspace.
/validation/vehicle-sample/
/validation/fusedlocation-sample/
docs/design/ui-concepts/

# Local editorial drafts and developer account selection; keep working copies.
/_workspace/
/.project-identity
/tmp/

